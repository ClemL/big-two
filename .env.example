# Multiplayer room storage (optional).
#
# Without these the app still runs: rooms fall back to an in-process Map, which
# is fine for `npm run dev` but NOT for a real deployment — serverless instances
# do not share memory, so players would land on different copies of the room.
#
# Provision Upstash Redis from the Vercel Marketplace (Vercel's own KV was
# retired in December 2024) and Vercel injects both values automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
